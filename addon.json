{
  "is-c3-addon": true,
  "sdk-version": 2,
  "type": "effect",
  "name": "Raindrop Refraction",
  "id": "sgtconti_raindrop_refract",
  "version": "1.5.0.0",
  "author": "SgtConti",
  "website": "https://github.com/SgtConti/c3_RaindropRefract",
  "documentation": "https://github.com/SgtConti/c3_RaindropRefract",
  "description": "Procedural rain on glass. The window fogs with condensation and running drops wipe it clear, each bead its own lens with its own refractive power and fall speed. Optional static dew. Supports WebGL and WebGPU.",
  "category": "distortion",
  "supported-renderers": ["webgl", "webgpu"],
  "blends-background": true,
  "must-predraw": true,
  "cross-sampling": true,
  "preserves-opaqueness": false,
  "animated": true,
  "parameters": [
    {"id": "density", "type": "percent", "initial-value": 0.22, "uniform": "uDensity", "interpolatable": true},
    {"id": "size", "type": "float", "initial-value": 48, "uniform": "uSize", "interpolatable": false},
    {"id": "speed", "type": "float", "initial-value": 1, "uniform": "uSpeed", "interpolatable": false},
    {"id": "randomMag", "type": "float", "initial-value": 1, "uniform": "uRandomMag", "interpolatable": true},
    {"id": "windX", "type": "float", "initial-value": 0, "uniform": "uWindX", "interpolatable": false},
    {"id": "strength", "type": "percent", "initial-value": 0.65, "uniform": "uStrength", "interpolatable": true},
    {"id": "blurLod", "type": "float", "initial-value": 0, "uniform": "uBlurLod", "interpolatable": false},
    {"id": "seed", "type": "float", "initial-value": 0, "uniform": "uSeed", "interpolatable": false},
    {"id": "variation", "type": "percent", "initial-value": 0.75, "uniform": "uVariation", "interpolatable": true},
    {"id": "smear", "type": "percent", "initial-value": 0.5, "uniform": "uSmear", "interpolatable": true},
    {"id": "speedVar", "type": "percent", "initial-value": 0.6, "uniform": "uSpeedVar", "interpolatable": true},
    {"id": "fog", "type": "percent", "initial-value": 0.4, "uniform": "uFog", "interpolatable": true},
    {"id": "dew", "type": "percent", "initial-value": 0, "uniform": "uDew", "interpolatable": true},
    {"id": "time", "type": "float", "initial-value": -1, "uniform": "uTime", "interpolatable": true}
  ],
  "file-list": ["addon.json", "effect.fx", "effect.wgsl", "icon.svg", "lang/en-US.json"]
}
